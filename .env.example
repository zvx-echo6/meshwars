# =============================================================================
# MeshWars configuration
# Copy this file to .env and edit the values below.
# =============================================================================

# --- REQUIRED ---
# The meshview instance MeshWars attaches to. Must include scheme.
MESHVIEW_BASE_URL=https://meshview.example.net

# --- Hop filter ---
# Accept position packets where (hop_start - hop_limit) <= MAX_HOPS.
# The code default is 99 (effectively unlimited). Tighten only if you
# want to require positions to be heard very close to the source.
#MAX_HOPS=99

# --- Storage ---
# Path inside the container. The docker-compose mount provides /data.
#DB_PATH=/data/game.db

# --- Upstream polling ---
#POLL_INTERVAL_SECONDS=45
#BACKFILL_HOURS=24
#UPSTREAM_RATE_PER_SEC=5.0
#UPSTREAM_CONCURRENCY=5

# --- Game rules ---
#SEASON_DAYS=30
#WINNER_BANNER_HOURS=72
#HISTORY_MAX=12
#EXCLUDED_ROLES=ROUTER,ROUTER_LATE,CLIENT_BASE

# --- Fortress scoring ---
#SCORE_PER_PACKET=0.5
#SCORE_PER_UNIQUE_NODE=1.0
#SCORE_DECAY_PER_DAY=0.25
#DEFENSE_WINDOW_SECONDS=900

# --- Internal / advanced ---
#POSITION_APP_PORTNUM=3

# --- Server bind ---
#LISTEN_HOST=0.0.0.0
#LISTEN_PORT=8090

# --- MeshCore board ---
# Comma-separated team roster, up to seven teams.
#TEAMS=RED,GREEN,BLUE,PURPLE,YELLOW,ORANGE,PINK
# Season length in days for the MeshCore board (its own season clock,
# separate from the Meshtastic SEASON_DAYS above).
#MC_SEASON_DAYS=30
# Which board loads first: "meshcore" or "meshtastic".
#MC_DEFAULT_VIEW=meshcore

# --- MeshCore scoring ---
# Points earned per distinct repeater a ping hears.
#MC_POINTS_PER_REPEATER=0.1
# Ceiling on points a single ping can earn, however many repeaters it hears.
#MC_MAX_POINTS_PER_PING=1.0
# One-time bonus the first time a given player paints a square for their team.
#MC_SCORE_PER_UNIQUE_PLAYER=0.5
# Per-day decay applied to all MeshCore square scores.
#MC_SCORE_DECAY_PER_DAY=0.25
# Seconds a freshly captured square is immune to being flipped.
#MC_DEFENSE_WINDOW_SECONDS=900
# Seconds before the same player can repaint the same square again.
#MC_COOLDOWN_SECONDS=300

# --- Play area ---
# Bounding box pings must fall inside to be accepted at all. Defaults
# cover Ontario, Oregon (NW) to Provo, Utah (SE). Setting north equal
# to south disables the check entirely (unbounded).
#PLAY_AREA_NORTH=44.10
#PLAY_AREA_SOUTH=40.20
#PLAY_AREA_WEST=-117.00
#PLAY_AREA_EAST=-111.60

# --- Registration (/join) ---
# Empty disables self-registration entirely. This must stay empty
# ("off") unless you intend to hand this code out to players -- never
# commit a real invite code here.
JOIN_INVITE_CODE=
#JOIN_RATE_LIMIT_ATTEMPTS=5
#JOIN_RATE_LIMIT_WINDOW_SECONDS=600
# Hostname used to build the MeshMapper config link shown on the join page.
#PUBLIC_HOST=meshwars.com
# Meshtastic registration is off by default -- it binds a radio for the
# future migration but cannot affect the Meshtastic board yet.
#JOIN_MESHTASTIC_ENABLED=false

# --- Admin interface (/admin) ---
# Empty disables the admin interface entirely. This token is the ONLY
# authentication the admin interface has -- never commit a real one here.
ADMIN_TOKEN=

# --- MeshCore raw batch diagnostic log ---
# Off by default. When on, writes every received wardriving batch,
# including real GPS positions, to a rotating file on disk (never the
# database). Meant to be switched on briefly for tuning, then off again.
#MC_RAW_LOG_ENABLED=false
#MC_RAW_LOG_PATH=/data/mc_raw.log
#MC_RAW_LOG_MAX_BYTES=10000000
#MC_RAW_LOG_BACKUPS=3

# --- MeshCore ingest (internal / advanced) ---
#MC_INGEST_ENABLED=true
#MC_QUEUE_MAX=10000
#MC_MAX_BATCH_PINGS=50
#MC_KEY_CACHE_SECONDS=60
#MC_MAX_SPEED_MPS=89.0
#MC_MAX_CLOCK_SKEW_SECONDS=3600
#MC_PING_RETENTION_HOURS=48
#MC_STAT_RETENTION_DAYS=30
#MC_INGEST_RATE_LIMIT_BATCHES=20
#MC_INGEST_RATE_LIMIT_WINDOW_SECONDS=60
#MC_STATUS_RATE_LIMIT_ATTEMPTS=30
#MC_STATUS_RATE_LIMIT_WINDOW_SECONDS=60

# --- Node management (/api/nodes) ---
# Per-key rate limit for registering/listing/removing radios on your
# own player. Keyed on the API key itself, not the caller's address.
#NODE_API_RATE_LIMIT_ATTEMPTS=30
#NODE_API_RATE_LIMIT_WINDOW_SECONDS=60

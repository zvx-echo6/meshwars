# =============================================================================
# MeshWars configuration
# Copy this file to .env and edit the values below.
# =============================================================================

# --- REQUIRED ---
# The meshview instance MeshWars attaches to. Must include scheme.
MESHVIEW_BASE_URL=https://meshview.example.net

# --- Hop filter ---
# Accept receptions where (hop_start - hop_limit) <= MAX_HOPS. 0 or less
# disables the filter entirely -- every reception counts no matter how
# many times the packet was relayed before a feeder heard it. This is
# the intended setting for this deployment (docker-compose.yml defaults
# MAX_HOPS to 0). Set it positive only if you want to require positions
# to be heard within a specific number of relays of the source.
#MAX_HOPS=0

# --- Storage ---
# Path inside the container. The docker-compose mount provides /data.
#DB_PATH=/data/game.db
#
# What gets mounted AT /data, host side. Leave this unset unless you
# have a reason: the default is the `meshwars-data` Docker named volume
# declared at the bottom of docker-compose.yml, which is where an
# existing install's database already lives. Point it at a directory
# instead and docker mounts that directory -- an EMPTY one on an
# existing install means the game comes up with no players, no squares
# and no history, because the real database is still in the volume.
#
# Two accepted forms, and the difference matters:
#   - a bare name that is declared under `volumes:` in
#     docker-compose.yml (today only `meshwars-data`) -> named volume.
#     Any other bare name is a hard error, not a new volume.
#   - a path, absolute (/srv/meshwars/data) or ./-relative to the repo
#     (./data) -> bind mount, created by docker if missing.
#MESHWARS_DATA=meshwars-data

# --- Terrain / overlay tiles ---
# Host directory holding the optional PMTiles archives (hillshade,
# public lands, USFS roads and trails) the map serves from /tiles.
# Bind-mounted read-only at /tiles-data. Entirely optional: with no
# archives present the map just draws without those overlays.
#
# The default is this project's own deployment path and is almost
# certainly wrong for you -- if you set nothing, docker creates that
# path on your machine (the reason a stray /var/home/... can appear on
# an atomic/immutable distro). Set it to a directory you own, even an
# empty one, or to ./data/tiles alongside the checkout.
#MESHWARS_TILES_DIR=/home/zvx/meshwars-tiles

# --- Upstream polling ---
#POLL_INTERVAL_SECONDS=45
#BACKFILL_HOURS=24
#UPSTREAM_RATE_PER_SEC=5.0
#UPSTREAM_CONCURRENCY=5

# --- Game rules ---
#SEASON_DAYS=180
#WINNER_BANNER_HOURS=72
#HISTORY_MAX=12
#EXCLUDED_ROLES=ROUTER,ROUTER_LATE,CLIENT_BASE

# --- Internal / advanced ---
#POSITION_APP_PORTNUM=3

# --- Server bind ---
#LISTEN_HOST=0.0.0.0
#LISTEN_PORT=8090

# --- MeshCore board ---
# Comma-separated team roster, up to seven teams.
#TEAMS=RED,GREEN,BLUE,PURPLE,YELLOW,ORANGE,PINK
# Season length in days for the MeshCore board (its own season clock,
# separate from the Meshtastic SEASON_DAYS above).
#MC_SEASON_DAYS=180
# Which board loads first: "meshcore" or "meshtastic".
#MC_DEFAULT_VIEW=meshcore

# --- MeshCore scoring ---
# Points earned per distinct repeater a ping hears.
#MC_POINTS_PER_REPEATER=0.1
# Ceiling on points a single ping can earn, however many repeaters it hears.
#MC_MAX_POINTS_PER_PING=1.0
# One-time bonus the first time a given player paints a square for their team.
#MC_SCORE_PER_UNIQUE_PLAYER=0.5
# Per-day decay applied to all MeshCore square scores.
#MC_SCORE_DECAY_PER_DAY=0.25
# Seconds a freshly captured square is immune to being flipped.
#MC_DEFENSE_WINDOW_SECONDS=900
# Seconds before the same player can repaint the same square again.
#MC_COOLDOWN_SECONDS=300

# --- Meshtastic scoring ---
# Same idea as the MeshCore points above, inverted. MeshCore scores by
# how many repeaters the PLAYER heard; meshview can only tell us the
# opposite -- how many distinct MQTT feeders (meshview's gateway nodes
# that heard the packet over the air and republished it to MQTT) heard
# THE PLAYER. Separate knobs from the MC_ ones above so the two boards
# tune independently.
# Points earned per distinct MQTT feeder that heard a ping.
#MT_POINTS_PER_FEEDER=0.1
# Ceiling on points a single ping can earn, however many feeders heard it.
#MT_MAX_POINTS_PER_PING=1.0

# --- Play area ---
# Bounding box pings must fall inside to be accepted at all. Defaults
# cover Ontario, Oregon (NW) to Provo, Utah (SE). Setting north equal
# to south disables the check entirely (unbounded).
#PLAY_AREA_NORTH=44.10
#PLAY_AREA_SOUTH=40.20
#PLAY_AREA_WEST=-117.00
#PLAY_AREA_EAST=-111.60

# --- Registration (/join) ---
# Empty disables self-registration entirely. This must stay empty
# ("off") unless you intend to hand this code out to players -- never
# commit a real invite code here.
JOIN_INVITE_CODE=
#JOIN_RATE_LIMIT_ATTEMPTS=5
#JOIN_RATE_LIMIT_WINDOW_SECONDS=600
# Hostname used to build the MeshMapper config link shown on the join page.
#PUBLIC_HOST=meshwars.com
# Google Search Console site-ownership token (its HTML-tag verification
# method). When set, rendered as a <meta name="google-site-verification">
# tag on every public page; when empty, the tag is left out entirely
# rather than emitted empty. Edit this and restart -- no rebuild needed.
#GOOGLE_SITE_VERIFICATION=
# This flag opens or closes Meshtastic registration for a deployment --
# when true, /join accepts Meshtastic players the same way MeshCore
# registration is already open. It is off by default because a fresh
# install has no business opening registration for a board it hasn't
# decided to run; a deployment that wants Meshtastic players turns this
# on in its own .env.
#JOIN_MESHTASTIC_ENABLED=false

# --- Admin interface (/admin) ---
# Empty disables the admin interface entirely. This token is the ONLY
# authentication the admin interface has -- never commit a real one here.
ADMIN_TOKEN=

# --- MeshCore raw batch diagnostic log ---
# Off by default. When on, writes every received wardriving batch,
# including real GPS positions, to a rotating file on disk (never the
# database). Meant to be switched on briefly for tuning, then off again.
#MC_RAW_LOG_ENABLED=false
#MC_RAW_LOG_PATH=/data/mc_raw.log
#MC_RAW_LOG_MAX_BYTES=10000000
#MC_RAW_LOG_BACKUPS=3

# --- MeshCore ingest (internal / advanced) ---
#MC_INGEST_ENABLED=true
#MC_QUEUE_MAX=10000
#MC_MAX_BATCH_PINGS=50
#MC_KEY_CACHE_SECONDS=60
#MC_MAX_SPEED_MPS=45.0
#MC_MAX_CLOCK_SKEW_SECONDS=3600
#MC_PING_RETENTION_HOURS=48
#MC_STAT_RETENTION_DAYS=30
#MC_INGEST_RATE_LIMIT_BATCHES=20
#MC_INGEST_RATE_LIMIT_WINDOW_SECONDS=60
#MC_STATUS_RATE_LIMIT_ATTEMPTS=30
#MC_STATUS_RATE_LIMIT_WINDOW_SECONDS=60

# --- Node management (/api/nodes) ---
# Per-key rate limit for registering/listing/removing radios on your
# own player. Keyed on the API key itself, not the caller's address.
#NODE_API_RATE_LIMIT_ATTEMPTS=30
#NODE_API_RATE_LIMIT_WINDOW_SECONDS=60

# --- Net check-ins (app/checkin.py) ---
# A second way to earn points, alongside squares held: checking in on a
# weekly net (Wednesday evenings) earns a registered player's team
# CHECKIN_POINTS once per player per net. Off by default -- a fresh
# install has not configured either upstream feed below and must not
# start polling a third-party service it was never told about.
#CHECKIN_ENABLED=false
#CHECKIN_POINTS=25.0
#CHECKIN_POLL_INTERVAL_SECONDS=30
# The net window: weekday (Python datetime.weekday(), Wednesday=2) and
# LOCAL hours in CHECKIN_NET_TIMEZONE, inclusive at both ends. Must be a
# real IANA zone name, never a fixed UTC offset, so the window stays
# correct across daylight-saving changes.
#CHECKIN_NET_WEEKDAY=2
#CHECKIN_NET_START_HOUR=17
#CHECKIN_NET_END_HOUR=23
#CHECKIN_NET_TIMEZONE=America/Boise
# Lower bound (local YYYY-MM-DD net date) on which net can be awarded.
# Both feeds hand back history on every poll, so this must be set to the
# date of the first net that should actually count before check-ins go
# live -- empty blocks every net rather than falling back to no lower
# bound, so a fresh install or upgrade can never retroactively award a
# past net just because it is still visible upstream.
#CHECKIN_NET_START_DATE=
# MeshCore weekly-net channel-messages feed, on a live.mwmesh.com-style
# host -- separate from MESHVIEW_BASE_URL above. Empty disables this
# half of check-ins even when CHECKIN_ENABLED is true.
MC_CHECKIN_BASE_URL=
#MC_CHECKIN_CHANNEL=#weekly-net
# Meshtastic check-in feed reuses MESHVIEW_BASE_URL (portnum=1 instead
# of 3), filtered by this hashtag -- no separate base URL setting.
#MT_CHECKIN_HASHTAG=#freq51
# MeshCore public-key directory (same host as MC_CHECKIN_BASE_URL,
# /api/nodes) used to auto-resolve a player's already-bound MeshCore
# radio contact to its current display name -- see app/checkin.py's
# module docstring. Cached and refreshed on its own interval.
#MC_CHECKIN_DIRECTORY_LIMIT=5000
#MC_CHECKIN_DIRECTORY_REFRESH_SECONDS=900

# ---------------------------------------------------------------------
# CARTO basemap API key (optional)
# ---------------------------------------------------------------------
# The map2 basemap is CARTO's dark_all raster tiles. CARTO serves an
# "API KEY REQUIRED" watermark over keyless usage; a free key (5M tile
# requests/month, from carto.com/basemaps/apikey) removes it. Leave this
# blank and the map still works -- the tiles are simply watermarked.
#
# This is NOT a secret: a basemap key is sent to every browser that
# loads the map and cannot be hidden from users. It is kept out of the
# repo anyway, and set per-deployment here.
#
# CARTO's free tier requires the CARTO and OpenStreetMap attribution
# stay visible on the map. map2.js sets it on the raster source and
# MapLibre's default attribution control renders it -- do not disable it.
CARTO_API_KEY=
